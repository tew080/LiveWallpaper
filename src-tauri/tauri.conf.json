{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "livewallpaper",
  "version": "0.1.0",
  "identifier": "com.tew404.livewallpaper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "livewallpaper",
        "url": "wallpaper",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
